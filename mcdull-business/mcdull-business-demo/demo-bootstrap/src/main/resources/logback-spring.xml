<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" debug="false">

  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProperty scope="context" name="applicationName" source="spring.application.name"
                  defaultValue="demo-bootstrap"/>
  <!-- 可通过 DEMO_LOG_PATH 环境变量覆盖；容器内建议挂载到 /data/logs/demo-bootstrap -->
  <springProperty scope="context" name="logPath" source="DEMO_LOG_PATH" defaultValue="./logs"/>

  <property name="LOG_PATTERN"
            value="|%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | %15t | %X{traceId} | %-42logger{36}:%line | %m | %n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${logPath}/${applicationName}/app.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${logPath}/${applicationName}/%d{yyyy-MM-dd}/app-%i.log.gz</fileNamePattern>
      <maxFileSize>50MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>5GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${logPath}/${applicationName}/error.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${logPath}/${applicationName}/%d{yyyy-MM-dd}/error-%i.log.gz</fileNamePattern>
      <maxFileSize>50MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>5GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
    <filter class="ch.qos.logback.classic.filter.LevelFilter">
      <level>ERROR</level>
      <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>
  </appender>

  <logger name="io.gitee.dqcer.mcdull.demo" level="DEBUG"/>
  <logger name="org.springframework" level="INFO"/>
  <logger name="com.baomidou.mybatisplus" level="INFO"/>

  <!-- 本地/未指定 profile：只输出控制台，避免在本地产生日志目录 -->
  <springProfile name="default | local">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <!-- 测试/生产：控制台 + 滚动文件 + 独立错误日志 -->
  <springProfile name="test | prod">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="FILE"/>
      <appender-ref ref="ERROR_FILE"/>
    </root>
  </springProfile>

</configuration>
