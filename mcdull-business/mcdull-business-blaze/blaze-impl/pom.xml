<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.gitee.dqcer</groupId>
        <artifactId>mcdull-business-blaze</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>blaze-impl</artifactId>
    <name>${project.artifactId} v${project.version}</name>

    <dependencies>
        <!-- 编译期只依赖 facade（SPI 接口 + 共享 Model 类） -->
        <!-- 运行时由 blaze-bootstrap 把 system-impl 装配进来提供本地 SPI 实现 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>system-facade</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcdull-framework-starter-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcdull-business-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- MyBatis-Plus 的 IService/ServiceImpl/IRepository/Page 由本模块直接使用 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcdull-framework-starter-mysql</artifactId>
            <version>${project.version}</version>
        </dependency>
            <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcdull-framework-starter-doc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 直接使用 StpKit/sa-token 注解鉴权，鉴权闸门也由本 starter 装配 -->
        <dependency>
            <groupId>io.gitee.dqcer</groupId>
            <artifactId>mcdull-framework-starter-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- VO 的 @DynamicDateFormat 与 @JsonSerialize(using = DynamicDateSerialize.class) 直接使用本模块 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcdull-framework-json</artifactId>
            <version>${project.version}</version>
        </dependency>
</dependencies>
</project>
