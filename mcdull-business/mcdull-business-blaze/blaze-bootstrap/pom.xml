<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.gitee.dqcer</groupId>
        <artifactId>mcdull-business-blaze</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>blaze-bootstrap</artifactId>
    <name>${project.artifactId} v${project.version}</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 原先由 system-impl 传递；Demo 工具类直接使用 hutool-crypto，改微服务后需显式声明 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-crypto</artifactId>
        </dependency>
        <dependency>
          <groupId>${project.groupId}</groupId>
            <artifactId>blaze-impl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 工作流能力通过契约远程调用：只引入 facade，避免 workflow-impl 被宽泛包扫描意外装配进 blaze 上下文 -->
        <dependency>
          <groupId>${project.groupId}</groupId>
            <artifactId>workflow-facade</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 全环境默认接入 Nacos：服务发现 + 共享配置导入 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcdull-framework-starter-nacos</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcdull-framework-starter-tag</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcdull-framework-starter-monitor</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- system-facade 对 feign starter 是 provided 依赖，不会传递到运行时；
             AuthApiHystrix 反射需要 InnerResult，必须在此显式引入 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcdull-framework-starter-feign</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
            <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcdull-framework-starter-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcdull-framework-starter-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcdull-framework-starter-mysql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 流程引擎运行时装配 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcdull-framework-starter-flow</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 运行时鉴权闸门：会话解析过滤器 + SaTokenExceptionAdvice -->
        <dependency>
            <groupId>io.gitee.dqcer</groupId>
            <artifactId>mcdull-framework-starter-security</artifactId>
            <version>${project.version}</version>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 测试默认执行：跳过只能用 -DskipTests 显式传入，禁止在模块 POM 中写死 -->

            <!-- 编译时，不执行 mvn deploy -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
